//AlunoGet
public class AlunoGet {
  private String nome;
  private double nota1;
  private double nota2;

  public AlunoGet(String nome, double nota1, double nota2){
    this.nome = nome;
    this.nota1 = nota1;
    this.nota2 = nota2;
  }
  public double getMedia(){
    return (nota1 + nota2) / 2;
  }
  }

//Aluno
public class Aluno {
  public String nome;
  public double nota1;
  public double nota2;

  public Aluno(String nome, double nota1, double nota2){
    this.nome = nome;
    this.nota1 = nota1;
    this.nota2 = nota2;
  }

  public void calculaMedia(double nota1, double nota2){
    double media = (nota1 + nota2) / 2;
    System.out.println("A média do aluno " + nome + " é: " + media);
  }
  
}

